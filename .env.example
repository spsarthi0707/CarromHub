# Copy to .env (docker compose reads it) or set these in your host's dashboard.

# Public hostname(s) the app is served on, comma-separated. "*" disables the check (fine behind a platform proxy).
ALLOWED_HOSTS=carromhub.example.com
DOMAIN=carromhub.example.com

# Set to 1 when behind Render/Fly/Caddy/Nginx so HTTPS is detected and cookies get the Secure flag.
TRUST_PROXY=1

# OTP delivery: "dev" shows the code in-app (testing only). "sms" posts {to, message} to SMS_WEBHOOK_URL.
OTP_DELIVERY=dev
SMS_WEBHOOK_URL=
SMS_WEBHOOK_KEY=

# Lets scripts / an AI assistant update content with header X-Admin-Key. Generate: openssl rand -hex 32
ADMIN_KEY=

# Where carrom.sqlite lives (mount a persistent disk here).
DATA_DIR=./data
